# Secret for signing session cookies.
# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string-min-32-chars

# Public application URL. Loaded during `npm run build` and used by
# adapter-node for CSRF protection and building correct URLs in production.
ORIGIN=http://localhost:3000

# Path to the SQLite database file (created automatically).
DATABASE_PATH=data/lifeexp.db

# Account created by `npm run db:seed`.
ADMIN_USERNAME=user
ADMIN_PASSWORD=set-a-strong-password-min-8-chars
ADMIN_DISPLAY_NAME=John

# Toggl Track → Profile Settings → API Token.
TOGGL_API_TOKEN=

# Empty = last 12 months. Format YYYY-MM-DD.
TOGGL_START_DATE=

# Minimum interval between syncs (protects the 30 requests/hour limit).
SYNC_INTERVAL_MINUTES=10

# true only when the application is running over HTTPS.
COOKIE_SECURE=false
